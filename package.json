{
  "name": "planner",
  "productName": "Planner",
  "version": "1.0.0",
  "description": "Project planner with nested tasks, shared subtasks and PDF export",
  "homepage": "https://github.com/DanielCC-1998/Planner-Orquestador",
  "desktopName": "planner.desktop",
  "author": "Daniel Cano Carrascosa",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "dist:win": "electron-vite build && electron-builder --win --x64",
    "dist:linux": "electron-vite build && electron-builder --linux --x64",
    "dist:linux:wsl": "node scripts/build-linux-wsl.mjs",
    "seed:big": "node scripts/seed-big.mjs .planner-data 5000",
    "icon": "node scripts/make-icon.mjs",
    "docs:screenshots": "electron-vite build && node scripts/docs-screenshots.mjs"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-virtual": "3.14.13",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "lucide-react": "1.49.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  }
}
